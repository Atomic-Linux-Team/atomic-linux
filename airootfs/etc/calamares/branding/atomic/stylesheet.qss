/* Estilo oscuro y moderno al estilo CachyOS */
QWidget {
    background-color: #060608;
    color: #e4e2e8;
    font-family: "FiraCode Nerd Font", "JetBrains Mono", monospace;
    font-size: 13px;
}

/* Contenedores principales */
QWidget#stepList {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #060608, stop:1 #0a0a10);
    border-right: 1px solid #1e1e2e;
}

QWidget {
    border: 1px solid #1e1e2e;
    border-radius: 8px;
}

/* Botones principales */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a0a10, stop:1 #060608);
    color: #e4e2e8;
    border: 1px solid #1e1e2e;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    min-height: 32px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e1e2e, stop:1 #0a0a10);
    border: 1px solid #bd94ff;
    color: #bd94ff;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #bd94ff, stop:1 #9854ff);
    color: #060608;
    border: 1px solid #bd94ff;
}

QPushButton:disabled {
    background-color: #0a0a10;
    color: #666666;
    border: 1px solid #333333;
}

/* Botones de acción primaria */
QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #bd94ff, stop:1 #9854ff);
    color: #060608;
    border: none;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d9b4ff, stop:1 #bd94ff);
    border: 1px solid #060608;
}

/* Barras de progreso */
QProgressBar {
    background-color: #0a0a10;
    border: 1px solid #1e1e2e;
    border-radius: 8px;
    text-align: center;
    color: #e4e2e8;
    height: 24px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #bd94ff, stop:1 #9854ff);
    border-radius: 7px;
    margin: 1px;
}

/* Campos de entrada */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #0a0a10;
    border: 1px solid #1e1e2e;
    border-radius: 4px;
    padding: 6px;
    color: #e4e2e8;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #bd94ff;
    background-color: #0d0d14;
}

/* Etiquetas */
QLabel {
    color: #e4e2e8;
    font-weight: bold;
}

QLabel#titleLabel {
    color: #bd94ff;
    font-size: 18px;
    font-weight: bold;
}

QLabel#subtitleLabel {
    color: #717180;
    font-size: 14px;
}

/* Separadores */
QFrame[frameShape="1"] {
    border: none;
    background-color: #2a2a3e;
    height: 1px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #0d0d14;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #2a2a3e;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3a3a4e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
